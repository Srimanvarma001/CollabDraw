# Copy to .env and fill in. The backends read .env from their own folder or
# from the repo root; Prisma reads it from the repo root or packages/db.

# --- Database (Prisma) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collabdraw

# --- Auth (http-backend + ws-backend) ---
# Required. Use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# How long sign-in tokens last (jsonwebtoken format: 7d, 12h, ...).
JWT_EXPIRES_IN=7d

# --- http-backend ---
PORT=3001
# Comma-separated origins allowed to call the API. Leave empty to allow any (dev only).
CORS_ORIGIN=http://localhost:3000
# Sign-in / sign-up attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT=10
# Set to the number of proxies in front of the API (e.g. 1) so rate limiting sees real client IPs.
TRUST_PROXY=

# --- frontend (Next.js) ---
# These are baked in at build time. For `next dev`, put them in apps/frontend/.env.local.
NEXT_PUBLIC_HTTP_BACKEND=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:8080
